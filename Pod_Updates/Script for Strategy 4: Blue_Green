#!/bin/bash
# File: blue-green.sh
# Strategy 4: Blue/Green
# Run two full environments side-by-side, then switch traffic instantly via Service selector

set -euo pipefail

NAMESPACE="${NAMESPACE:-default}"
APP_NAME="demo-app"
IMAGE_BLUE="nginx:1.25"    # current live version
IMAGE_GREEN="nginx:1.26"   # new version

echo "=== Strategy 4: Blue/Green Deployment ==="
echo "Namespace: $NAMESPACE"
echo ""

# 1. Create Blue (current production)
cat <<EOF | kubectl apply -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${APP_NAME}-blue
  namespace: ${NAMESPACE}
  labels:
    app: ${APP_NAME}
    version: blue
spec:
  replicas: 3
  selector:
    matchLabels:
      app: ${APP_NAME}
      version: blue
  template:
    metadata:
      labels:
        app: ${APP_NAME}
        version: blue
    spec:
      containers:
      - name: nginx
        image: ${IMAGE_BLUE}
        ports:
        - containerPort: 80
        readinessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 3
          periodSeconds: 5
EOF

echo "✅ Blue environment created (${APP_NAME}-blue)"

# 2. Create Green (new version)
cat <<EOF | kubectl apply -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${APP_NAME}-green
  namespace: ${NAMESPACE}
  labels:
    app: ${APP_NAME}
    version: green
spec:
  replicas: 3
  selector:
    matchLabels:
      app: ${APP_NAME}
      version: green
  template:
    metadata:
      labels:
        app: ${APP_NAME}
        version: green
    spec:
      containers:
      - name: nginx
        image: ${IMAGE_GREEN}
        ports:
        - containerPort: 80
        readinessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 3
          periodSeconds: 5
EOF

echo "✅ Green environment created (${APP_NAME}-green)"

# 3. Create Service pointing to Blue initially
cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: Service
metadata:
  name: ${APP_NAME}
  namespace: ${NAMESPACE}
spec:
  selector:
    app: ${APP_NAME}
    version: blue          # starts on Blue
  ports:
  - port: 80
    targetPort: 80
  type: ClusterIP
EOF

echo "✅ Service created (currently selecting version=blue)"
echo ""

cat <<EOF

============================================
BLUE/GREEN OPERATIONS
============================================

# Check both environments
kubectl get pods -l app=${APP_NAME} -n ${NAMESPACE} -o wide
kubectl get svc ${APP_NAME} -n ${NAMESPACE}

# Wait until Green is fully ready
kubectl rollout status deployment/${APP_NAME}-green -n ${NAMESPACE}

# === SWITCH TO GREEN (instant) ===
kubectl patch service ${APP_NAME} -n ${NAMESPACE} \\
  -p '{"spec":{"selector":{"app":"${APP_NAME}","version":"green"}}}'

# Verify the switch
kubectl get endpoints ${APP_NAME} -n ${NAMESPACE}
kubectl describe service ${APP_NAME} -n ${NAMESPACE} | grep -A5 Selector

# === ROLLBACK TO BLUE (instant) ===
kubectl patch service ${APP_NAME} -n ${NAMESPACE} \\
  -p '{"spec":{"selector":{"app":"${APP_NAME}","version":"blue"}}}'

# Optional: scale down the inactive version to save resources
# kubectl scale deployment ${APP_NAME}-blue --replicas=0 -n ${NAMESPACE}

# Cleanup
# kubectl delete deployment ${APP_NAME}-blue ${APP_NAME}-green -n ${NAMESPACE}
# kubectl delete service ${APP_NAME} -n ${NAMESPACE}
EOF
