#!/bin/bash
# File: recreate-strategy.sh
# Strategy 3: Recreate
# Stops every v1 pod first, then starts v2 pods.
# Simple, no version overlap, but causes downtime.

set -euo pipefail

NAMESPACE="${NAMESPACE:-default}"
APP_NAME="demo-app"
IMAGE_V1="nginx:1.25"
IMAGE_V2="nginx:1.26"

echo "=== Strategy 3: Recreate ==="
echo "Namespace: $NAMESPACE"
echo ""

# Create Deployment with Recreate strategy
cat <<EOF | kubectl apply -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${APP_NAME}-recreate
  namespace: ${NAMESPACE}
  labels:
    app: ${APP_NAME}
    strategy: recreate
spec:
  replicas: 3
  strategy:
    type: Recreate                 # Kill all old pods before creating new ones
  selector:
    matchLabels:
      app: ${APP_NAME}
      strategy: recreate
  template:
    metadata:
      labels:
        app: ${APP_NAME}
        strategy: recreate
        version: v1
    spec:
      containers:
      - name: nginx
        image: ${IMAGE_V1}
        ports:
        - containerPort: 80
        readinessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 5
          periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: ${APP_NAME}-recreate
  namespace: ${NAMESPACE}
spec:
  selector:
    app: ${APP_NAME}
    strategy: recreate
  ports:
  - port: 80
    targetPort: 80
  type: ClusterIP
EOF

echo "✅ Recreate deployment created: ${APP_NAME}-recreate"
echo "   → strategy.type: Recreate"
echo "   → All v1 pods will be terminated before any v2 pods start"
echo ""

cat <<EOF

============================================
HOW TO USE
============================================

# Trigger the recreate rollout (change image)
kubectl set image deployment/${APP_NAME}-recreate nginx=${IMAGE_V2} -n ${NAMESPACE}

# Watch the process
# You will see all pods terminate first, then new ones start
kubectl rollout status deployment/${APP_NAME}-recreate -n ${NAMESPACE} --watch

# Check pods during the process
kubectl get pods -l app=${APP_NAME},strategy=recreate -n ${NAMESPACE} -w

# Rollback (also uses Recreate strategy)
kubectl rollout undo deployment/${APP_NAME}-recreate -n ${NAMESPACE}

# Cleanup
# kubectl delete deployment,svc ${APP_NAME}-recreate -n ${NAMESPACE}
EOF
